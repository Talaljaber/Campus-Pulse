# CampusPulse environment. Copy to .env (gitignored). Placeholders only, never real values.
# Every line carries "# scope: ai|web|cli". Secrets live server-side only.

# ---- scope ai: services/ai (Render, or local) ----
OPENROUTER_API_KEY=            # scope: ai  (secret)
OPENROUTER_TIER1_MODEL=        # scope: ai  (pinned model id)
OPENROUTER_TIER2_MODEL=        # scope: ai  (documented, leave unset: tier 2 is off, UD-3)
ENABLE_LLM=false               # scope: ai
LLM_DAILY_BUDGET_USD=5.0       # scope: ai
LLM_TIMEOUT_S=20               # scope: ai
LLM_MAX_RETRIES=2              # scope: ai  (5xx/timeouts only)
LLM_RETRY_BACKOFF_S=0.5        # scope: ai
LLM_CACHE_PATH=.cache/llm.sqlite # scope: ai  (response cache, keyed by prompt version + input)
SUPABASE_URL=                  # scope: ai
SUPABASE_SERVICE_ROLE_KEY=     # scope: ai  (secret, never on Netlify)
AI_SERVICE_TOKEN=              # scope: ai  (secret, shared with web; unset = every /v1 route answers 401)
AUTH_MODE=supabase_jwt         # scope: ai  (supabase_jwt = verified user token + profiles; trusted_headers = X-CP-* headers, local/tests only)
AUTH_CACHE_S=60                # scope: ai  (seconds a verified user token is cached)
AUTH_TIMEOUT_S=5               # scope: ai  (per Supabase Auth / profiles call)
REPORTS_DIR=reports            # scope: ai  (model_lab.json for /v1/metrics)
BATCH_MAX_ROWS=10000           # scope: ai  (/v1/batch rows per upload)
BATCH_MAX_BYTES=5000000        # scope: ai  (/v1/batch upload size)
REDTEAM_MAX_N=200              # scope: ai  (items per red-team run)
REDTEAM_SEED_CSV=data/clean/train_clean.csv # scope: ai  (red-team seed texts; holdouts are refused)
GMAIL_SMTP_USER=               # scope: ai  (the campuspulse support Gmail address)
GMAIL_APP_PASSWORD=            # scope: ai  (secret, Gmail app password)
SMTP_HOST=smtp.gmail.com       # scope: ai
SMTP_PORT=465                  # scope: ai  (implicit TLS; 587 STARTTLS is blocked on some networks)
SMTP_TIMEOUT_S=10              # scope: ai
SMTP_MAX_RETRIES=2             # scope: ai  (4xx, disconnects and timeouts only)
SMTP_BACKOFF_S=1.0             # scope: ai  (exponential)
SMTP_DAILY_CAP=100             # scope: ai  (sends per Amman day; Gmail allows 500)
DEMO_EMAIL_ALLOWLIST=          # scope: ai  (comma-separated; empty rejects every recipient)
DEMO_STUDENT_INBOX=            # scope: ai  (allow-listed demo inbox standing in for students' email)
DEMO_OFFICE_INBOX=             # scope: ai  (allow-listed demo inbox for safety and transport alerts)
LINEAR_API_KEY=                # scope: ai  (secret)
LINEAR_WEBHOOK_SECRET=         # scope: ai  (secret)
OUTBOUND_WEBHOOK_URL=          # scope: ai
OUTBOUND_WEBHOOK_SECRET=       # scope: ai  (secret)
ENABLE_SINKS=true              # scope: ai
SINK_RETRY_MAX=3               # scope: ai  (attempts per sink call)
SINK_RETRY_BASE_S=0.5          # scope: ai  (exponential backoff base)
GAMING_MIN_REQUESTS=5          # scope: ai
GAMING_CLAIM_RATIO=0.8         # scope: ai
GAMING_HIGH_RATIO_MAX=0.2      # scope: ai
REVIEW_FALLBACK_OFFICE=academic # scope: ai  (UD-13: queue of an unsure request with no advisor)
REVIEW_LIST_LIMIT=50           # scope: ai  (GET /v1/reviews items per call)
REVIEW_EMAIL_ADVISOR=true      # scope: ai  (email the advisor's allow-listed demo inbox on assignment)
SLA_SCAN_MINUTES=5             # scope: ai  (SLA scanner interval; 0 disables it)
INCIDENT_WINDOW_MIN=30         # scope: ai
ARTIFACT_DIR=models/frozen     # scope: ai
ORT_INTRA_OP_THREADS=4         # scope: ai  (Render sets 1)
CAMPUSPULSE_ROOT=              # scope: ai  (optional repo-root override)

# ---- scope web: apps/web (Netlify) ----
# NEXT_PUBLIC_SUPABASE_ANON_KEY is SPEC section 11's SUPABASE_ANON_KEY, renamed for Next.js.
NEXT_PUBLIC_SUPABASE_URL=      # scope: web
NEXT_PUBLIC_SUPABASE_ANON_KEY= # scope: web
NEXT_PUBLIC_DEMO_LOGIN_HINT=   # scope: web  (optional hint line on /login; never the password)
AI_SERVICE_URL=                # scope: web
AI_SERVICE_TOKEN=              # scope: web  (secret; Functions/runtime scope too)

# ---- scope cli: dev machine and scripts ----
SUPABASE_PROJECT_REF=          # scope: cli
SUPABASE_DB_PASSWORD=          # scope: cli
SUPABASE_TEST_URL=             # scope: cli
PORT=10000                     # scope: cli  (Render injects it; uvicorn binds to it)

# ---- future work (S1), intentionally not read by Settings ----
# WHATSAPP_TOKEN=
# DEMO_PHONE_ALLOWLIST=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# DEMO_CALENDAR_IDS=
