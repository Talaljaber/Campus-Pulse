# CampusPulse environment. Copy to .env (gitignored). Placeholders only, never real values.
# Every line carries "# scope: ai|web|cli". Secrets live server-side only.

# ---- scope ai: services/ai (Render, or local) ----
OPENROUTER_API_KEY=            # scope: ai  (secret)
OPENROUTER_TIER1_MODEL=        # scope: ai  (pinned model id)
OPENROUTER_TIER2_MODEL=        # scope: ai  (documented, leave unset: tier 2 is off, UD-3)
ENABLE_LLM=false               # scope: ai
LLM_DAILY_BUDGET_USD=5.0       # scope: ai
LLM_TIMEOUT_S=20               # scope: ai
LLM_MAX_RETRIES=2              # scope: ai  (5xx/timeouts only)
LLM_RETRY_BACKOFF_S=0.5        # scope: ai
LLM_CACHE_PATH=.cache/llm.sqlite # scope: ai  (response cache, keyed by prompt version + input)
LLM_ARABIZI_TRANSLATE=false    # scope: ai  (optional: LLM translates Arabizi to English in front of the encoder; needs OPENROUTER_API_KEY; off = scored offline path)
LLM_ARABIZI_MODEL=openai/gpt-4o-mini-2024-07-18 # scope: ai  (pinned model id)
LLM_ARABIZI_TIMEOUT_S=6        # scope: ai  (a slow call means no translation, never an error)
LLM_ARABIZI_CACHE_PATH=.cache/llm_arabizi.sqlite # scope: ai  (response cache)
LLM_MODEL=                     # scope: ai  (pinned OpenRouter model id for the LLM features; empty = each feature's own default)
LLM_PROVIDER_ORDER=            # scope: ai  (comma-separated OpenRouter provider slugs, in order; empty = OpenRouter chooses)
LLM_PROVIDER_ALLOW_FALLBACKS=false # scope: ai  (false: never route outside LLM_PROVIDER_ORDER)
LLM_PROVIDER_DATA_COLLECTION=deny # scope: ai  (allow or deny: deny routes only to providers that do not retain or train on prompts)
LLM_REASONING_OFF=true         # scope: ai  (send reasoning enabled=false to models that support it)
SUPABASE_URL=                  # scope: ai
SUPABASE_SERVICE_ROLE_KEY=     # scope: ai  (secret, never on Netlify)
STORE_TIMEOUT_S=30             # scope: ai  (seconds per PostgREST call of the API)
AI_SERVICE_TOKEN=              # scope: ai  (secret, shared with web; unset = every /v1 route answers 401)
AUTH_MODE=supabase_jwt         # scope: ai  (supabase_jwt = verified user token + profiles; trusted_headers = X-CP-* headers, local/tests only)
AUTH_CACHE_S=60                # scope: ai  (seconds a verified user token is cached)
AUTH_TIMEOUT_S=5               # scope: ai  (per Supabase Auth / profiles call)
REPORTS_DIR=reports            # scope: ai  (model_lab.json for /v1/metrics)
BATCH_MAX_ROWS=10000           # scope: ai  (/v1/batch rows per upload)
BATCH_MAX_BYTES=5000000        # scope: ai  (/v1/batch upload size)
REDTEAM_MAX_N=200              # scope: ai  (items per red-team run)
REDTEAM_SEED_CSV=data/clean/train_clean.csv # scope: ai  (red-team seed texts; holdouts are refused)
GMAIL_SMTP_USER=               # scope: ai  (the campuspulse support Gmail address)
GMAIL_APP_PASSWORD=            # scope: ai  (secret, Gmail app password)
SMTP_HOST=smtp.gmail.com       # scope: ai
SMTP_PORT=465                  # scope: ai  (implicit TLS; 587 STARTTLS is blocked on some networks)
SMTP_TIMEOUT_S=10              # scope: ai
SMTP_MAX_RETRIES=2             # scope: ai  (4xx, disconnects and timeouts only)
SMTP_BACKOFF_S=1.0             # scope: ai  (exponential)
SMTP_DAILY_CAP=100             # scope: ai  (sends per Amman day; Gmail allows 500)
DEMO_EMAIL_ALLOWLIST=          # scope: ai  (comma-separated; empty rejects every recipient)
EMAIL_OPT_IN=false             # scope: ai  (allow current profile-consented demo notification addresses)
SHARED_ISSUES_ENABLED=false    # scope: ai  (enable P10 shared outage matching after migrations 0017/0018)
DEMO_STUDENT_INBOX=            # scope: ai  (allow-listed demo inbox standing in for students' email)
DEMO_OFFICE_INBOX=             # scope: ai  (allow-listed demo inbox for safety and transport alerts)
DEMO_OFFICE_INBOXES=           # scope: ai  (per-office demo inboxes: it=a@x.com,finance=b@x.com; others use DEMO_OFFICE_INBOX)
DEMO_ADMIN_INBOX=              # scope: ai  (allow-listed demo inbox for admin copies of ticket emails)
PUBLIC_WEB_URL=                # scope: ai  (web app base URL for links in emails, no trailing slash)
LINEAR_API_KEY=                # scope: ai  (secret)
LINEAR_WEBHOOK_SECRET=         # scope: ai  (secret)
OUTBOUND_WEBHOOK_URL=          # scope: ai
OUTBOUND_WEBHOOK_SECRET=       # scope: ai  (secret)
ENABLE_SINKS=true              # scope: ai
SINK_RETRY_MAX=3               # scope: ai  (attempts per sink call)
SINK_RETRY_BASE_S=0.5          # scope: ai  (exponential backoff base)
GAMING_MIN_REQUESTS=5          # scope: ai
GAMING_CLAIM_RATIO=0.8         # scope: ai
GAMING_HIGH_RATIO_MAX=0.2      # scope: ai
REVIEW_FALLBACK_OFFICE=academic # scope: ai  (UD-13: queue of an unsure request with no advisor)
REVIEW_LIST_LIMIT=50           # scope: ai  (GET /v1/reviews items per call)
REVIEW_EMAIL_ADVISOR=true      # scope: ai  (email the advisor's allow-listed demo inbox on assignment)
SLA_SCAN_MINUTES=5             # scope: ai  (SLA reminder scanner interval; 0 disables it)
SLA_SWEEP_MIN_INTERVAL_S=60    # scope: ai  (SLA sweep after API responses, at most this often; 0 disables it)
INCIDENT_WINDOW_MIN=30         # scope: ai
ARTIFACT_DIR=models/frozen     # scope: ai
ORT_INTRA_OP_THREADS=4         # scope: ai  (Render sets 1)
ORT_LOW_MEMORY=true            # scope: ai  (no ONNX arena/prepacking: ~15 MB less RSS, same vectors)
MEMORY_QUERY_CACHE_S=2         # scope: ai  (reuse one live-memory query per request; 0 disables)
CAMPUSPULSE_ROOT=              # scope: ai  (optional repo-root override)

# ---- scope web: apps/web (Netlify) ----
# NEXT_PUBLIC_SUPABASE_ANON_KEY is SPEC section 11's SUPABASE_ANON_KEY, renamed for Next.js.
NEXT_PUBLIC_SUPABASE_URL=      # scope: web
NEXT_PUBLIC_SUPABASE_ANON_KEY= # scope: web
NEXT_PUBLIC_DEMO_LOGIN_HINT=   # scope: web  (optional hint line on /login; never the password)
AI_SERVICE_URL=                # scope: web
AI_SERVICE_TOKEN=              # scope: web  (secret; Functions/runtime scope too)

# ---- scope cli: dev machine and scripts ----
SUPABASE_PROJECT_REF=          # scope: cli
SUPABASE_DB_PASSWORD=          # scope: cli
SUPABASE_TEST_URL=             # scope: cli
PORT=10000                     # scope: cli  (Render injects it; uvicorn binds to it)

# ---- future work (S1), intentionally not read by Settings ----
# WHATSAPP_TOKEN=
# DEMO_PHONE_ALLOWLIST=
# GOOGLE_SERVICE_ACCOUNT_JSON=
# DEMO_CALENDAR_IDS=
LLM_FRONTEND=false             # scope: ai  (optional: LLM translates Arabic and Arabizi to English in front of the encoder and writes an internal explanation; needs OPENROUTER_API_KEY; off = scored offline path; P7.4)
LLM_FRONTEND_CONFIG=config/llm_frontend.yaml # scope: ai  (pinned model, timeout, workers, cache)
LLM_FRONTEND_MODEL=            # scope: ai  (optional override of the pinned model; measurements only)
LLM_FRONTEND_CACHE_PATH=       # scope: ai  (optional override of the response cache path)
LLM_ORACLE=                    # scope: ai  (optional override of config/llm_frontend.yaml oracle.enabled: the predict.py tie-breaker, D-058; measurements)
LLM_ORACLE_PRIORITY=           # scope: ai  (optional override of oracle.priority: the tie-breaker also re-judges priority, D-058)
LLM_ORACLE_PROMPT_VERSION=     # scope: ai  (optional override of oracle.prompt_version: v1 | v2 | v3, D-059)
LLM_ORACLE_LOWER_HIGH=         # scope: ai  (optional override of oracle.lower_unflagged_high: a model high no floor set may be corrected, D-059)
LLM_ORACLE_CATEGORY_TOP_K=     # scope: ai  (optional override of oracle.category_top_k: choose among the model's top k categories, D-060)
CHAT_AGENT_ENABLED=true        # scope: ai  (the chat agent talks through the LLM only with OPENROUTER_API_KEY and this not false; otherwise the web shows the plain form; P9.8)
CHAT_AGENT_ALLOW_FALLBACKS=true # scope: ai  (chat only: with no LLM_PROVIDER_ORDER, another OpenRouter provider may answer when one is rate-limited; LLM_PROVIDER_DATA_COLLECTION still applies)
CHAT_AGENT_CONFIG=config/chat_agent.yaml # scope: ai  (pinned model, prompt file, hint threshold, proposal ttl, templates)
KNOWLEDGE_MIN_SIM=0.82         # scope: ai  (P10.19: e5 cosine floor for a knowledge-base passage to reach the chat; calibrated on a short handbook)
